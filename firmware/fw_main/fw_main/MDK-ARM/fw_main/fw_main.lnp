--cpu Cortex-M3
"fw_main\startup_stm32f103xb.o"
"fw_main\main.o"
"fw_main\stm32f1xx_it.o"
"fw_main\stm32f1xx_hal_msp.o"
"fw_main\stm32f1xx_hal_gpio_ex.o"
"fw_main\stm32f1xx_hal_uart.o"
"fw_main\stm32f1xx_hal.o"
"fw_main\stm32f1xx_hal_rcc.o"
"fw_main\stm32f1xx_hal_rcc_ex.o"
"fw_main\stm32f1xx_hal_gpio.o"
"fw_main\stm32f1xx_hal_dma.o"
"fw_main\stm32f1xx_hal_cortex.o"
"fw_main\stm32f1xx_hal_pwr.o"
"fw_main\stm32f1xx_hal_flash.o"
"fw_main\stm32f1xx_hal_flash_ex.o"
"fw_main\stm32f1xx_hal_exti.o"
"fw_main\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "fw_main\fw_main.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "fw_main.map" -o fw_main\fw_main.axf